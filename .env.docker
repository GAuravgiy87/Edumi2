# ============================================================
#  EduMi2 — Docker Environment File
#
#  EDIT THIS FILE before deploying.
#  Then run:  docker compose --env-file .env.docker up -d --build
#
#  Only change the values marked with  <-- CHANGE THIS
# ============================================================


# ── Your server's LAN IP ─────────────────────────────────────
# Run  ipconfig  (Windows) or  ip a  (Linux) to find it.
# Students open  http://<SERVER_IP>  in their browser.
SERVER_IP=192.168.1.100                          # <-- CHANGE THIS


# ── Django secret key ────────────────────────────────────────
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-docker-secret-key-change-me   # <-- CHANGE THIS


# ── Database credentials ─────────────────────────────────────
# These are used by both Postgres and Django.
POSTGRES_DB=edumi
POSTGRES_USER=edumi
POSTGRES_PASSWORD=edumi                          # <-- CHANGE THIS in production


# ── LiveKit API credentials ──────────────────────────────────
# Must match the keys block in livekit.yaml
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_must_be_32_characters_long_1234   # <-- CHANGE THIS


# ── Face recognition encryption key ─────────────────────────
# Generate one:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_ENCRYPTION_KEY=zl-c_61OHA9zX1LiIJ9cinnXJOXQhRkBEIs2JvJRh6Y=   # <-- CHANGE THIS
